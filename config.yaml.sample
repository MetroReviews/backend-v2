token:  # Main bot token
helper_token:  # Secondary/helper bot token (unused directly, kept for parity) (optional)
gid:  # Main guild ID
reviewer:  # Reviewer role ID
queue_channel:  # Channel where new bots are announced
list_owner:  # List Owner role ID
sudo:  # Sudo role ID
test_ping_role:  # Optional role pinged instead of reviewer (optional)
client_secret:  # Discord OAuth2 client secret
owners:
  - 
postgres_url: postgres:///brc # e.g. postgres:///brc (optional)
bind_addr: :8080 # e.g. :8080 (optional)
allowed_host:  # admin/host, e.g. catnip.metrobots.xyz (optional)
oauth_redirect:  # frostpaw redirect URI (optional)
default_login_state:  # fallback panel origin (optional)